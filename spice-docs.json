{
  "$schema": "https://spiceframework.dev/schemas/spice-docs.schema.json",
  "schema": 1,
  "product": {
    "id": "smtp",
    "title": "SMTP",
    "family": "integration",
    "summary": "Opt-in SMTP integration for Spice applications with explicit configuration, lifecycle, and compatibility contracts.",
    "maturity": "preview",
    "audience": [
      "application-developer",
      "operator"
    ]
  },
  "content": [
    {
      "source": "README.md",
      "route": "index",
      "kind": "how-to",
      "order": 0,
      "search": true
    },
    {
      "source": "docs/**/*.md",
      "routeFrom": "docs",
      "order": 10,
      "search": true
    }
  ],
  "snippets": [
    {
      "root": ".",
      "include": [
        "**/*.go"
      ],
      "exclude": [
        "vendor/**",
        "internal/spicegen/**",
        ".generated/**"
      ]
    }
  ]
}
